# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_wechat
REDIS_URL=redis://localhost:6379
LLM_PROVIDER=glm

# GLM
GLM_API_KEY=replace_me
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4.7

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=

# Qwen (OpenAI-compatible)
QWEN_API_KEY=replace_me
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen2-72b-instruct

# Kimi (OpenAI-compatible)
KIMI_API_KEY=replace_me
KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k

# Minimax
MINIMAX_API_KEY=replace_me
MINIMAX_BASE_URL=https://api.minimax.chat/v1/text/chatcompletion_pro
MINIMAX_MODEL=abab5.5-chat

# Doubao (OpenAI-compatible)
DOUBAO_API_KEY=replace_me
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=ep-20240115175546-467jv

# Gemini
GEMINI_API_KEY=replace_me
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1/models/gemini-1.5-flash-lite:generateContent
GEMINI_MODEL=gemini-1.5-flash-lite
